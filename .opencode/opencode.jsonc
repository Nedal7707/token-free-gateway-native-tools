{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "This is the token-free-gateway development repo (Bun + TypeScript).",
    "Run tests with: bun test. Typecheck with: bunx tsc --noEmit (lenient on .mjs imports).",
    "The shared compaction module lives at C:\\VectorHQ\\shared-compaction\\compaction.mjs and is mirrored into src/shared/compaction.mjs — keep them byte-identical (copy verbatim, run the shared test).",
    "Provider model lists must match the current generation served by each web provider; verify against the live /v1/models catalog before changing them.",
    "Never commit credentials. Keys are env-referenced only."
  ],
  "provider": {
    "command-code": {
      "api": "http://127.0.0.1:3457/v1",
      "env": [
        "COMMAND_CODE_API_KEY"
      ],
      "name": "Command Code"
    },
    "opencode-go": {
      "api": "http://127.0.0.1:3460/opencode/v1",
      "env": [
        "OPENCODE_API_KEY"
      ],
      "name": "OpenCode Go"
    },
    "gateway": {
      "api": "http://127.0.0.1:3461/v1",
      "env": [
        "TFG_API_KEY"
      ],
      "name": "Token-Free Gateway"
    },
    "nvidia": {
      "api": "http://127.0.0.1:3460/nvidia/v1",
      "env": [
        "NVIDIA_API_KEY"
      ],
      "name": "Nvidia"
    },
    "aihubmix": {
      "api": "http://127.0.0.1:3460/aihubmix/v1",
      "env": [
        "AIHUBMIX_API_KEY"
      ],
      "name": "AIHubMix"
    },
    "zenmux": {
      "api": "http://127.0.0.1:3460/zenmux/v1",
      "env": [
        "ZENMUX_API_KEY"
      ],
      "name": "ZenMux"
    },
    "cloudflare": {
      "api": "http://127.0.0.1:3460/cloudflare/v1",
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ],
      "name": "Cloudflare"
    }
  },
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "mcp": {
    "worktree-proof": {
      "type": "local",
      "command": [
        "C:\\VectorHQ\\worktree-proof-workflow\\bin\\worktree-proof-mcp.js"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "tools": {
    "browser": true,
    "chrome": true,
    "computer-use": true,
    "visualize": true
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "doom_loop": "allow",
    "external_directory": "allow"
  },
  "logLevel": "INFO"
}
